@@ -0,0 +1,39 @@
+//! Round-robin selection among targets whose owners have released them.
+const std = @import("std");
+
+pub fn next(available: []const bool, previous: usize) ?usize {
+    for (1..available.len + 1) |offset| {
+        const index = (previous + offset) % available.len;
+        if (available[index]) return index;
+    }
+    return null;
+}
+
+test "all ownership combinations preserve exclusion and round-robin order" {
+    for (0..16) |mask| {
+        var available: [4]bool = undefined;
+        for (&available, 0..) |*value, index| {
+            value.* = mask & (@as(usize, 1) << @intCast(index)) != 0;
+        }
+        for (0..4) |previous| {
+            const chosen = next(&available, previous);
+            if (mask == 0) {
+                try std.testing.expectEqual(null, chosen);
+                continue;
+            }
+            try std.testing.expect(chosen != null);
+            try std.testing.expect(available[chosen.?]);
+            const distance = (chosen.? + 4 - previous - 1) % 4;
+            for (0..distance) |offset| {
+                try std.testing.expect(!available[(previous + offset + 1) % 4]);
+            }
+        }
+    }
+}
+
+test "a retired target becomes eligible without an unsafe timeout fallback" {
+    var available = [_]bool{ false, false, false, false };
+    for (0..1_000) |_| try std.testing.expectEqual(null, next(&available, 0));
+    available[2] = true;
+    try std.testing.expectEqual(@as(?usize, 2), next(&available, 0));
+}
