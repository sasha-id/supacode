diff --git a/src/renderer/DrawTimer.zig b/src/renderer/DrawTimer.zig
new file mode 100644
index 000000000..ec0eec5fa
--- /dev/null
+++ b/src/renderer/DrawTimer.zig
@@ -0,0 +1,46 @@
+//! Tracks one run of deferred draws using timestamps from a monotonic clock.
+const DrawTimer = @This();
+const std = @import("std");
+
+started_at: ?u64 = null,
+
+pub fn elapsed(self: *DrawTimer, now: u64) u64 {
+    const start = self.started_at orelse now;
+    self.started_at = start;
+    return now - start;
+}
+
+pub fn reset(self: *DrawTimer) void {
+    self.* = .{};
+}
+
+test "delayed retries retain elapsed time" {
+    var timer: DrawTimer = .{};
+    try std.testing.expectEqual(0, timer.elapsed(0));
+    try std.testing.expectEqual(45 * std.time.ns_per_ms, timer.elapsed(45 * std.time.ns_per_ms));
+    try std.testing.expectEqual(90 * std.time.ns_per_ms, timer.elapsed(90 * std.time.ns_per_ms));
+}
+
+test "retry at the deadline does not restart it" {
+    var timer: DrawTimer = .{};
+    try std.testing.expectEqual(0, timer.elapsed(100 * std.time.ns_per_ms));
+    try std.testing.expectEqual(40 * std.time.ns_per_ms, timer.elapsed(140 * std.time.ns_per_ms));
+}
+
+test "lifecycle reset grants a new interval" {
+    var timer: DrawTimer = .{};
+    _ = timer.elapsed(0);
+    _ = timer.elapsed(8 * std.time.ns_per_ms);
+    timer.reset();
+    try std.testing.expectEqual(0, timer.elapsed(1_000 * std.time.ns_per_ms));
+    try std.testing.expectEqual(8 * std.time.ns_per_ms, timer.elapsed(1_008 * std.time.ns_per_ms));
+}
+
+test "successful draw reset separates consecutive runs" {
+    var timer: DrawTimer = .{};
+    _ = timer.elapsed(0);
+    _ = timer.elapsed(32 * std.time.ns_per_ms);
+    timer.reset();
+    try std.testing.expectEqual(0, timer.elapsed(36 * std.time.ns_per_ms));
+    try std.testing.expectEqual(40 * std.time.ns_per_ms, timer.elapsed(76 * std.time.ns_per_ms));
+}
